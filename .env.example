# Database (default: SQLite file in project data/processed/)
DATABASE_URL=sqlite:///data/processed/discovery.db

# Primary LLM (Phase 2+): gemini | groq | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# 2.0-flash deprecated for new keys; use a current flash model from ListModels
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional LLM fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Relevance batching (records per API request is min of BATCH_SIZE and token cap)
RELEVANCE_BATCH_SIZE=12
RELEVANCE_MAX_BATCH_INPUT_TOKENS=28000
RELEVANCE_BATCH_DELAY_SECONDS=2
# Gemini free/low tier defaults; raise if your quota allows (see Google AI Studio)
GEMINI_RPM_LIMIT=10
GEMINI_TPM_LIMIT=250000
# RELEVANCE_MAX_LLM_CALLS=50

# YouTube Data API (Phase 7)
YOUTUBE_API_KEY=

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: emit one JSON log line per record in pipeline stages
LOG_JSON=false
